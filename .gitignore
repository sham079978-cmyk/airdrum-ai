# dependencies
node_modules/

# build output
dist/

# MediaPipe WASM runtime — copied in from node_modules by tools/setup-assets.mjs
# on `npm install`, so it is not committed (it must match the installed
# @mediapipe/tasks-vision version).
public/wasm/

# MediaPipe hand model (~7.5 MB of float16 weights, does not compress).
# Downloaded once by tools/setup-assets.mjs on `npm install`. Not committed
# because it exceeds the GitHub API's request size limit for a single file.
public/models/*.task

# misc
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vite/
