{
  "name": "airdrum-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AirDrum AI — play a virtual drum kit in the air using hand movements tracked through your webcam.",
  "license": "MIT",
  "keywords": [
    "mediapipe",
    "hand-tracking",
    "web-audio",
    "computer-vision",
    "drums",
    "vite"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node tools/setup-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test tests/",
    "smoke": "npm run build && node tools/smoke-test.mjs",
    "samples": "python tools/generate_samples.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "vite": "^5.4.21"
  }
}